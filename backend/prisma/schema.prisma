generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
}
