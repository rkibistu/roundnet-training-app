generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  invitesCreated Invite[]    @relation("CreatedBy")
  invitesUsed    Invite[]    @relation("UsedBy")
  exercises      Exercise[]
}

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  createdBy String
  usedBy    String?
  createdAt DateTime @default(now())

  creator Player  @relation("CreatedBy", fields: [createdBy], references: [id])
  user    Player? @relation("UsedBy", fields: [usedBy], references: [id])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  exercises Exercise[]
}

model Exercise {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  createdBy  String
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id])
  creator  Player   @relation(fields: [createdBy], references: [id])
}
