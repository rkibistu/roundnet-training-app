generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  invitesCreated Invite[]    @relation("CreatedBy")
  invitesUsed    Invite[]    @relation("UsedBy")
  exercises      Exercise[]
  sessions       Session[]
  xpLedger       XpLedger[]
}

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  createdBy String
  usedBy    String?
  createdAt DateTime @default(now())

  creator Player  @relation("CreatedBy", fields: [createdBy], references: [id])
  user    Player? @relation("UsedBy", fields: [usedBy], references: [id])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  exercises Exercise[]
  xpLedger  XpLedger[]
}

model Exercise {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  createdBy  String
  createdAt  DateTime @default(now())

  category       Category       @relation(fields: [categoryId], references: [id])
  creator        Player         @relation(fields: [createdBy], references: [id])
  sessionEntries SessionEntry[]
}

model Session {
  id        String   @id @default(cuid())
  playerId  String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  player  Player         @relation(fields: [playerId], references: [id])
  entries SessionEntry[]
}

model SessionEntry {
  id              String   @id @default(cuid())
  sessionId       String
  exerciseId      String
  durationMinutes Int
  qualityScore    Int
  xpEarned        Float
  createdAt       DateTime @default(now())

  session    Session    @relation(fields: [sessionId], references: [id])
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])
  xpLedger   XpLedger[]
}

model XpLedger {
  id            String   @id @default(cuid())
  playerId      String
  categoryId    String?
  xp            Float
  sourceEntryId String
  createdAt     DateTime @default(now())

  player      Player       @relation(fields: [playerId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  sourceEntry SessionEntry @relation(fields: [sourceEntryId], references: [id])
}
